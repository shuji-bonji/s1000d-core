{
  "name": "@shuji-bonji/s1000d-core",
  "version": "0.8.0",
  "description": "Core library for reading S1000D® CSDB objects: DMC/ICN parsing, identification and status section, XML/XPath layer. Not affiliated with ASD.",
  "keywords": [
    "s1000d",
    "ietm",
    "ietp",
    "technical-publications",
    "dmc",
    "icn",
    "brex",
    "xml",
    "xpath",
    "typescript",
    "mcp"
  ],
  "author": "shuji-bonji",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuji-bonji/s1000d-core.git"
  },
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./xsd-libxml2": {
      "types": "./dist/xsd-libxml2.d.ts",
      "import": "./dist/xsd-libxml2.js"
    },
    "./schema/draft.schema.json": "./schema/draft.schema.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:spec": "S1000D_SPEC_TESTS=1 vitest --run",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "fontoxpath": "^3.34.0"
  },
  "peerDependencies": {
    "libxml2-wasm": "^0.7.2"
  },
  "peerDependenciesMeta": {
    "libxml2-wasm": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.1.8",
    "libxml2-wasm": "^0.7.2",
    "prettier": "^3.8.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.53.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
